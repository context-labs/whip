{
  "name": "@whip/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build && node scripts/verify-static.mjs",
    "build:storybook": "npm run generate && storybook build",
    "check": "npm run generate && tsc --noEmit",
    "deploy": "cd dist/deploy && node ../../scripts/deploy.mjs",
    "package:deploy": "node scripts/package-deploy.mjs",
    "dev": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "generate": "node scripts/generate.mjs",
    "preview": "node scripts/preview.mjs",
    "storybook": "npm run generate && storybook dev -p 6007",
    "test": "vitest run",
    "test:browser": "npm run build:storybook && playwright test",
    "test:dev": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tanstack/router-generator": "1.167.46",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "github-slugger": "2.0.0",
    "jsdom": "29.1.1",
    "mdast-util-to-string": "4.0.0",
    "refractor": "5.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
