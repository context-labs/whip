{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "after": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "upcoming": {
      "type": "boolean"
    },
    "cursor": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "due": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "due",
        "id"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$id": "https://whip.dev/protocol/v4/ListSchedulesParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ListSchedulesParams",
  "required": [
    "session_id",
    "limit"
  ],
  "additionalProperties": false
}
