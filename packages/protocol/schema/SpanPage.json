          "parent_id": {
            "type": "string"
          },
          "root_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "turn_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "start_ns": {
            "type": "string",
