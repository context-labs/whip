{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "expected_current": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "max_continuations": {
          "type": [
            "null",
            "string"
          ],
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "start": {
      "type": "boolean"
    }
  },
  "$id": "https://whip.dev/protocol/v4/CreateGoalParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateGoalParams",
  "required": [
    "session_id",
    "goal_id",
    "expected_current",
    "spec",
    "start"
  ],
  "additionalProperties": false
}
