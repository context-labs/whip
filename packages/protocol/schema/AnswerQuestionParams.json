{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[^\\x00]{0,1000}|[^\\x00]{1000}[^\\x00]{0,1000}|[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{0,1000}|[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{0,1000}|[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{1000}[^\\x00]{0,96})$"
            },
            "minItems": 0,
            "maxItems": 7
          },
          "dismissed": {
            "type": "boolean"
          }
        },
        "required": [
          "answer",
          "dismissed"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "$id": "https://whip.dev/protocol/v4/AnswerQuestionParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnswerQuestionParams",
  "required": [
    "session_id",
    "operation_id",
    "answers"
  ],
  "additionalProperties": false
}
