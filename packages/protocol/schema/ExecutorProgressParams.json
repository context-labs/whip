{
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "$id": "https://whip.dev/protocol/v4/ExecutorProgressParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutorProgressParams",
  "required": [
    "epoch",
    "generation",
    "invocation_id",
    "text"
  ],
  "additionalProperties": false
}
