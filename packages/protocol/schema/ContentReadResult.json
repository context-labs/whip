{
  "type": "object",
  "properties": {
    "data": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    },
    "content": {
      "type": "object",
      "properties": {
        "reference_id": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "format": "int64"
        },
        "media_type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "digest",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://whip.dev/protocol/v3/ContentReadResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentReadResult",
  "required": [
    "data",
    "content"
  ],
  "additionalProperties": false
}
