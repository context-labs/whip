{
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "env",
              "inference-net",
              "openai-codex"
            ]
          },
          "environment": {
            "type": "string",
            "maxLength": 256
          },
          "credential_state": {
            "type": "string",
            "enum": [
              "available",
              "refresh_required"
            ]
          }
        },
        "required": [
          "provider",
          "source",
          "environment",
          "credential_state"
        ],
        "additionalProperties": false
      },
      "maxItems": 24
    }
  },
  "$id": "https://whip.dev/protocol/v4/ProviderCandidates",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderCandidates",
  "required": [
    "revision",
    "items"
  ],
  "additionalProperties": false
}
