          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "prompt",
            "compact",
