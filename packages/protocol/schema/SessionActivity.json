          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        },
        "goal": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$",
              "format": "counter"
