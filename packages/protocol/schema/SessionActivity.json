            "string"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "history_revision",
        "goal",
        "id",
        "session_id",
        "kind",
        "config_revision",
        "state",
        "failure",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "active_input_id": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
