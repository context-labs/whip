{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "after": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$id": "https://whip.dev/protocol/v4/HistoryParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryParams",
  "required": [
    "session_id",
    "after",
    "limit"
  ],
  "additionalProperties": false
}
