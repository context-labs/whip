{
  "type": "object",
  "properties": {
    "items": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "turn_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "input_id": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "sequence": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "format": "counter"
          },
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "pattern": "^[\\s\\S]+$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "reference_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "content"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "reference_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 128
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "session_id",
          "turn_id",
          "input_id",
          "sequence",
          "role",
          "parts",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "$id": "https://whip.dev/protocol/v4/HistoryResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryResult",
  "required": [
    "items"
  ],
  "additionalProperties": false
}
