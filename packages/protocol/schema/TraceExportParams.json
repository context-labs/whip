{
  "type": "object",
  "properties": {
    "root_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^([a-f0-9]{32})?$"
    },
    "expected_revision": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    }
  },
  "$id": "https://whip.dev/protocol/v4/TraceExportParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceExportParams",
  "required": [
    "root_id",
    "trace_id",
    "expected_revision"
  ],
  "additionalProperties": false
}
