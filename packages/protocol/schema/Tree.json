{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "archived",
        "pinned"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "string",
      "enum": [
        "starlark",
        "quickjs"
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_queued_inputs_per_session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "max_depth",
        "max_sessions",
        "max_queued_inputs_per_session"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "created_at": {
      "type": "string"
    }
  },
  "$id": "https://whip.dev/protocol/v4/Tree",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tree",
  "required": [
    "id",
    "metadata",
    "engine",
    "policy",
    "revision",
    "created_at"
  ],
  "additionalProperties": false
}
