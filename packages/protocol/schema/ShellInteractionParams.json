{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    }
  },
  "$id": "https://whip.dev/protocol/v4/ShellInteractionParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShellInteractionParams",
  "required": [
    "session_id",
    "cursor"
  ],
  "additionalProperties": false
}
