{
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "live",
            "dedicated",
            "headless",
            "extension"
          ]
        },
        "executable": {
          "type": "string",
          "maxLength": 4096
        },
        "live_endpoint": {
          "type": "string",
          "maxLength": 4096
        },
        "live_profile": {
          "type": "string",
          "maxLength": 4096
        },
        "allow_private_urls": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "executable",
        "live_endpoint",
        "live_profile",
        "allow_private_urls"
      ],
      "additionalProperties": false
    },
    "driver": {
      "type": "string",
      "enum": [
        "rod",
        "chromedp"
      ]
    },
    "driver_pinned": {
      "type": "boolean"
    }
  },
  "$id": "https://whip.dev/protocol/v4/ExternalBrowserStatus",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExternalBrowserStatus",
  "required": [
    "revision",
    "configuration",
    "driver",
    "driver_pinned"
  ],
  "additionalProperties": false
}
