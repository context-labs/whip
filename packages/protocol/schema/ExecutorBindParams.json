{
  "type": "object",
  "properties": {
    "definition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
      },
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "$id": "https://whip.dev/protocol/v4/ExecutorBindParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutorBindParams",
  "required": [
    "definition",
    "tools",
    "hooks"
  ],
  "additionalProperties": false
}
