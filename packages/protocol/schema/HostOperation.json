{
  "type": "object",
  "properties": {
    "permission_revision": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^[1-9][0-9]{0,18}$",
      "format": "counter"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "cell_id": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "cell",
        "host_operation"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "capability": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "arguments": true,
    "state": {
      "type": "string",
      "enum": [
        "waiting",
        "ready",
        "dispatched",
        "succeeded",
        "failed",
        "denied",
        "cancelled",
        "uncertain"
      ]
    },
    "grant_id": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "result": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "denied",
            "cancelled",
            "uncertain"
          ]
        },
        "value": true,
        "failure": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    },
    "dispatched_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "finished_at": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "$id": "https://whip.dev/protocol/v4/HostOperation",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HostOperation",
  "required": [
    "permission_revision",
    "id",
    "session_id",
    "turn_id",
    "cell_id",
    "origin",
    "request_id",
    "capability",
    "resource",
    "arguments",
    "state",
    "grant_id",
    "result",
    "created_at",
    "dispatched_at",
    "finished_at"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "cell_id": {
          "not": {
            "type": "null"
          }
        },
        "origin": {
          "enum": [
            "cell"
          ]
        }
      }
    },
    {
      "properties": {
        "cell_id": {
          "type": "null"
        },
        "origin": {
          "enum": [
            "host_operation"
          ]
        }
      }
    }
  ]
}
