{
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "declaration": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "openai-chat",
            "openai-responses",
            "openai-codex"
          ]
        },
        "base_url": {
          "type": "string",
          "maxLength": 4000
        },
        "credential": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "env",
                "file",
                "command",
                "none",
                "inference-net"
              ]
            },
            "environment": {
              "type": "string",
              "maxLength": 256
            },
            "file": {
              "type": "string",
              "maxLength": 4096
            },
            "command": {
              "type": [
                "null",
                "object"
              ],
              "properties": {
                "executable": {
                  "type": "string",
                  "maxLength": 4096
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "maxItems": 64
                },
                "environment": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "maxItems": 64
                }
              },
              "required": [
                "executable",
                "arguments",
                "environment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source",
            "environment",
            "file",
            "command"
          ],
          "additionalProperties": false
        },
        "models": {
          "type": [
            "object",
            "null"
          ],
          "maxProperties": 1024,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prices": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "counter"
                  },
                  "output": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "counter"
                  },
                  "reasoning": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "counter"
                  },
                  "cached_input": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "counter"
                  },
                  "cached_output": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "counter"
                  }
                },
                "required": [
                  "input",
                  "output",
                  "reasoning",
                  "cached_input",
                  "cached_output"
                ],
                "additionalProperties": false
              },
              "context_window_tokens": {
                "type": [
                  "null",
                  "string"
                ],
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "max_output_tokens": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "timeout_millis": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "prices",
              "context_window_tokens",
              "max_output_tokens",
              "timeout_millis",
              "max_attempts"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "kind",
        "base_url",
        "credential",
        "models"
      ],
      "additionalProperties": false
    },
    "keep_credential": {
      "type": "boolean"
    },
    "key": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "key": {
          "type": "string",
          "maxLength": 65536,
          "pattern": "^[!-~]+$"
        }
      },
      "required": [
        "id",
        "key"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://whip.dev/protocol/v4/ChangeProviderParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeProviderParams",
  "required": [
    "revision",
    "provider",
    "declaration",
    "keep_credential",
    "key"
  ],
  "additionalProperties": false
}
