{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "cursor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "format": "int64"
    },
    "bytes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    }
  },
  "$id": "https://whip.dev/protocol/v6/TerminalOutputParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerminalOutputParams",
  "required": [
    "id",
    "cursor",
    "bytes"
  ],
  "additionalProperties": false
}
