      "required": [
        "id",
        "session_id",
        "capture_id",
        "state",
        "scope",
        "semantics",
        "created_at",
        "released_at"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://whip.dev/protocol/v4/WorkspaceResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceResult",
