{
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000- ]+$"
    },
    "root_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000- ]+$"
    },
    "provider_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000- ]+$"
    },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tab_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\u0000- ]+$"
          },
          "tab_generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\u0000- ]+$"
          }
        },
        "required": [
          "tab_id",
          "tab_generation"
        ],
        "additionalProperties": false
      },
      "maxItems": 72
    }
  },
  "$id": "https://whip.dev/protocol/v4/BrowserInventoryRequest",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrowserInventoryRequest",
  "required": [
    "request_id",
    "root_id",
    "agent_id",
    "provider_id",
    "provider_epoch",
    "tabs"
  ],
  "additionalProperties": false
}
