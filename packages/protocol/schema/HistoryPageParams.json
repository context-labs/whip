{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "direction": {
      "type": "string",
      "enum": [
        "forward",
        "backward"
      ]
    },
    "cursor": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "expected_revision": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$id": "https://whip.dev/protocol/v4/HistoryPageParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryPageParams",
  "required": [
    "session_id",
    "direction",
    "limit"
  ],
  "additionalProperties": false
}
