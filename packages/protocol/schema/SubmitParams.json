{
  "type": "object",
  "properties": {
    "design_context": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "context_attachment_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "screenshot_attachment_id": {
          "type": [
            "null",
            "string"
          ],
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "elements": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minimum": 1,
                "maximum": 160
              },
              "selector": {
                "type": "string",
                "maximum": 256
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "maximum": 8
        },
        "element_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "page_url": {
          "type": "string",
          "maximum": 2048
        },
        "page_title": {
          "type": "string",
          "maximum": 256
        }
      },
      "required": [
        "context_attachment_id",
        "elements",
        "element_count"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "client_id",
        "request_id"
      ],
      "additionalProperties": false
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "agent"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "pattern": "^[\\s\\S]+$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "content"
                ]
              }
            },
            "required": [
              "type",
              "reference_id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 128
    }
  },
  "$id": "https://whip.dev/protocol/v4/SubmitParams",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubmitParams",
  "required": [
    "identity",
    "session_id",
    "source",
    "parts"
  ],
  "additionalProperties": false
}
