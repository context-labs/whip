{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tree": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "pinned": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "title",
                  "archived",
                  "pinned"
                ],
                "additionalProperties": false
              },
              "engine": {
                "type": "string",
                "enum": [
                  "starlark",
                  "quickjs"
                ]
              },
              "revision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "created_at": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "metadata",
              "engine",
              "revision",
              "created_at"
            ],
            "additionalProperties": false
          },
          "root_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "working_directory": {
            "type": "string",
            "maxLength": 4096
          },
          "activity": {
            "type": "object",
            "properties": {
              "active_turn_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "queued_input_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "pending_permission_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "pending_question_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              },
              "active_workspace_action_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "format": "counter"
              }
            },
            "required": [
              "active_turn_count",
              "queued_input_count",
              "pending_permission_count",
              "pending_question_count",
              "active_workspace_action_count"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "tree",
          "root_id",
          "working_directory",
          "activity"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "missing_root_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
      },
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "$id": "https://whip.dev/protocol/v4/TreeSummariesResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TreeSummariesResult",
  "required": [
    "items",
    "missing_root_ids"
  ],
  "additionalProperties": false
}
