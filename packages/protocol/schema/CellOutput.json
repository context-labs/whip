{
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "preview": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "turn_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "cell_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "call_message_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "history_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "cell_id",
        "call_message_id",
        "call_id",
        "history_revision",
        "revision",
        "text",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://whip.dev/protocol/v4/CellOutput",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CellOutput",
  "required": [
    "epoch",
    "preview"
  ],
  "additionalProperties": false
}
