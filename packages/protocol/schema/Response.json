{
  "type": "object",
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "result": true,
    "error": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "INVALID",
            "NOT_FOUND",
            "CONFLICT",
            "BUSY",
            "LIMIT",
            "STOPPED",
            "CLOSED",
            "IDENTITY",
            "METHOD",
            "ACCOUNT_CREDENTIALS",
            "ACCOUNT_SETUP",
            "ACCOUNT_CONFIGURATION",
            "ACCOUNT_LOGOUT",
            "ACCOUNT_MANAGEMENT",
            "INTERNAL"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://whip.dev/protocol/v4/Response",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "required": [
    "jsonrpc",
    "id"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
