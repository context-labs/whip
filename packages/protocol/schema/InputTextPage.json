{
  "type": "object",
  "properties": {
    "items": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "input_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "ordinal": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "format": "counter"
          },
          "text": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "session_id",
          "input_id",
          "ordinal",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "next_cursor": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "format": "counter"
    },
    "scanned_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "skipped_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    }
  },
  "$id": "https://whip.dev/protocol/v4/InputTextPage",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InputTextPage",
  "required": [
    "items",
    "next_cursor",
    "scanned_count",
    "skipped_count"
  ],
  "additionalProperties": false
}
