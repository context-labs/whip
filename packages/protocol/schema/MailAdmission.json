{
  "type": "object",
  "properties": {
    "mail_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "mail": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        },
        "sender_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "recipient_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "queued",
            "steer",
            "next_turn"
          ]
        },
        "subject": {
          "type": "string"
        },
        "body_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "format": "counter"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "delivered",
            "done"
          ]
        },
        "available_at": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "revised_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "sender_id",
        "recipient_id",
        "delivery",
        "subject",
        "body_bytes",
        "state",
        "available_at",
        "created_at",
        "revised_at"
      ],
      "additionalProperties": false
    },
    "deleted_at": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "$id": "https://whip.dev/protocol/v4/MailAdmission",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MailAdmission",
  "required": [
    "mail_id",
    "mail",
    "deleted_at"
  ],
  "additionalProperties": false
}
