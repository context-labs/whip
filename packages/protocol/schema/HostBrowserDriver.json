  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configured_driver": {
      "type": "string",
      "enum": [
        "rod",
        "chromedp"
      ]
    },
    "driver": {
      "type": "string",
      "enum": [
        "rod",
        "chromedp"
      ]
    },
    "pinned": {
      "type": "boolean"
    }
  },
  "$id": "https://whip.dev/protocol/v4/HostBrowserDriver",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HostBrowserDriver",
  "required": [
    "revision",
    "configured_driver",
    "driver",
    "pinned"
  ],
  "additionalProperties": false
}
