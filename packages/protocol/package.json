{
  "name": "@whip/protocol",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    }
  },
  "scripts": {
    "generate": "go run ../../cmd/whip-contract -out schema && node scripts/generate.mjs",
    "check:drift": "go run ../../cmd/whip-contract -out schema -check && node scripts/generate.mjs --check",
    "check": "tsc --noEmit && node --disallow-code-generation-from-strings --test scripts/interop.test.mjs && npm run check:drift"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "ajv": "8.20.0"
  },
  "files": [
    "generated"
  ]
}
