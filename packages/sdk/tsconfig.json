{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "declaration": true,
    "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
