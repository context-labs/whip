{
  "name": "@whip/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" },
    "./state": { "types": "./dist/state.d.ts", "import": "./dist/state.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./agents": { "types": "./dist/agents.d.ts", "import": "./dist/agents.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" },
    "./testing/node": { "types": "./dist/testing-node.d.ts", "import": "./dist/testing-node.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "test": "tsc -p tsconfig.test.json && node --test build/test/*.test.js"
  },
  "dependencies": { "@whip/protocol": "3.0.0" },
  "peerDependencies": { "react": "^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } }
}
