{
  "name": "@whip/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WHIP's accessible React component library and shared theme catalog. Source distribution; requires the StyleX compiler.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.stylex.ts",
    "./themes": "./src/themes.tsx",
    "./workspace-tabs": "./src/workspace-tabs.tsx",
    "./workspace-layout": "./src/workspace-layout.tsx",
    "./reset.css": "./src/reset.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens.stylex": "./src/tokens.stylex.ts",
    "./package.json": "./package.json",
    "./theme-data": "./src/theme-data.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:suggestions": "node tests/textarea-suggestions.mjs",
    "test:tabs": "node tests/workspace-tabs.mjs",
    "test:layout": "node tests/workspace-layout.mjs",
    "test:csp": "node tests/csp.mjs",
    "test:mermaid": "node tests/mermaid.mjs",
    "test:packed": "node tests/packed.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:visual:update": "node tests/visual.mjs --update",
    "test:visual:proof": "node tests/visual.mjs --prove-diff"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "beautiful-mermaid": "1.1.3",
    "lucide-react": "1.47.0",
    "react-resizable-panels": "4.13.2",
    "refractor": "5.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
