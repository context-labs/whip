#!/bin/sh
# All branches use the same lightweight whole-module check. Complete race,
# product and platform suites remain explicit CI gates, not commit side effects.
set -e

cd "$(git rev-parse --show-toplevel)"
task check:fast

# Keep local lint optional, but use CI's pinned tool and frozen baseline whenever
# the contributor has opted into lint tooling. Never move the baseline by branch.
if command -v golangci-lint >/dev/null 2>&1; then
	task lint
else
	echo "pre-commit: golangci-lint not installed — skipping (CI will run it)" >&2
fi
