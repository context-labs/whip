# EAS replaces .gitignore; keep the shared exclusions in sync.
/whip
/whipcode
/vendor/

# Swift driver build artifacts (task driver rebuilds; go:embed uses the
# copy at internal/computer/bin/, which stays ignored too — the placeholder
# is force-added instead).
driver/.build/
internal/tui/whip-transcript-*.md

# TypeScript clients: generated contracts are tracked, build output is not.
node_modules/
packages/sdk/dist/
packages/sdk/build/
examples/*/dist/
apps/*/dist/
apps/desktop/out/
apps/desktop/.stage/
apps/desktop/.dev/
apps/web/renderer-manifest.json
packages/ui/storybook-static/
packages/ui/ui-test-results/
test-results/
playwright-report/
*.tgz

# Browser release assets copied by scripts/pack-web.mjs before Go builds.
internal/webassets/dist/*
!internal/webassets/dist/.gitkeep

# Expo native projects are generated by config plugins.
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
.ai-docs/plans/mobile-app/*.log
.ai-docs/plans/mobile-app/artifacts/

/apps/mobile/dist/

# Local research, native acceptance artifacts and credentials are not build inputs.
.ai-docs/
# Evaluation environments, caches and session traces are not mobile build inputs.
/evals/
.env
.env.*
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
credentials.json

# Nested mobile/native-module build output and machine-local files.
apps/mobile/modules/*/android/build/
.gradle/
.kotlin/
.expo/
expo-env.d.ts
web-build/
*.orig.*
*.key
*.pem
*.tsbuildinfo
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
